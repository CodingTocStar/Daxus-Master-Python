    "# Eliminar producto\n",
    "def eliminar_producto():\n",
    "    \"\"\"Solicita el nombre de un producto, valida la entrada y lo elimina si existe.\"\"\"\n",
    "    while True:\n",
    "        try:\n",
    "            producto_eliminar = input(\"Producto a eliminar: \").title().strip()\n",
    "            if not producto_eliminar.replace(\" \", \"\").isalpha():\n",
    "                raise ValueError(\n",
    "                    \"El nombre debe contener unicamente letras y espacios (no puede ser vacio).\")\n",
    "        except ValueError as e:\n",
    "            print(f\"Ocurrio un error. Error: {e}\")\n",
    "        else:\n",
    "            break\n",
    "\n",
    "    producto_encontrado = None\n",
    "\n",
    "    for producto in inventario:\n",
    "        if producto[\"Nombre\"] == producto_eliminar:\n",
    "            producto_encontrado = producto\n",
    "            break  # salgo del for\n",
    "\n",
    "    if producto_encontrado is not None:\n",
    "        inventario.remove(producto_encontrado)\n",
    "        print(f\"\\n'{producto_eliminar}' eliminado exitosamente.\\n\")\n",
    "    else:\n",
    "        print(f\"\\n'{producto_eliminar}' no existe en el inventario.\\n\")\n",
    "\n",
    "    print(\"-\" * 40)\n",
    "\n",
    "\n",
    "# Visualizar inventario\n",
    "def abrir_inventario():\n",
    "    \"\"\"Muestra todos los productos del inventario y el valor total acumulado.\"\"\"\n",
    "    if not inventario:\n",
    "        print(\"\\nEl inventario esta vacio.\\n\")\n",
    "        print(\"*\" * 40)\n",
    "        return\n",
    "\n",
    "    for producto in inventario:\n",
    "        print(\"\\n\" + \"*\" * 40 + \"\\n\")\n",
    "        print(f\"Nombre: {producto['Nombre']}\")\n",
    "        print(f\"Cantidad: {producto['Cantidad']}\")\n",
    "        print(f\"Precio unitario: ${producto['Precio unitario']:.2f}\")\n",
    "        print(f\"Valor en stock: ${producto['Valor en stock']:.2f}\")\n",
    "\n",
    "    valor_total_inventario = sum(\n",
    "        producto[\"Valor en stock\"] for producto in inventario)\n",
    "    print(\"\\n\" + \"*\" * 40)\n",
    "    print(f\"Valor total del inventario: ${valor_total_inventario:.2f}\")\n",
    "    print(\"*\" * 40)\n",
    "\n",
    "\n",
    "# Menu\n",
    "def menu():\n",
    "    \"\"\"Muestra el menu donde se ejecutan las demas funciones para hacer funcionar el programa.\"\"\"\n",
    "    print(\"Bienvenido al Sistema de Control de Inventario 5.0\")\n",
    "    opcion = None\n",
    "\n",
    "    while opcion != 0:\n",
    "        print(\"\\nElija una opcion:\")\n",
    "        print(\"1 - Ingresar nuevo producto.\")\n",
    "        print(\"2 - Actualizar producto.\")\n",
    "        print(\"3 - Eliminar producto.\")\n",
    "        print(\"4 - Abrir inventario.\")\n",
    "        print(\"0 - Finalizar programa.\")\n",
    "\n",
    "        while True:\n",
    "            try:\n",
    "                opcion = int(input(\"Su eleccion: \"))\n",
    "                if opcion not in (0, 1, 2, 3, 4):\n",
    "                    raise ValueError(\"Ingrese una opcion valida (0 a 4).\")\n",
    "            except ValueError as e:\n",
    "                print(f\"\\nOcurrio un error: {e}\\n\")\n",
    "            else:\n",
    "                break\n",
    "\n",
    "        if opcion == 1:\n",
    "            ingresar_producto()\n",
    "\n",
    "        elif opcion == 2:\n",
    "            actualizar_producto()\n",
    "\n",
    "        elif opcion == 3:\n",
    "            eliminar_producto()\n",
    "\n",
    "        elif opcion == 4:\n",
    "            abrir_inventario()\n",
    "\n",
    "        elif opcion == 0:\n",
    "            print(\"\\nFinalizando programa.\\n\")\n",
    "\n",
    "        print(\"-\" * 40)\n",
    "\n",
    "    print(\"=\" * 40)\n",
    "    print(\"\\nPrograma finalizado.\\n\")\n",
    "\n",
    "\n",
    "# Ejecucion del programa\n",
    "inventario = []  # tiene que ser global o las funciones no van a poder acceder\n",
    "\n",
    "menu()"
   ]
  }
